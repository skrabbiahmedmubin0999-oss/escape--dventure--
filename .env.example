# Escape Adventure - Environment Configuration Example

PORT=3000
NODE_ENV=development

# Persistent server data directory; use durable storage in production.
DATA_DIR=.data

# Required in production: generate a unique random value of at least 32 bytes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional comma-separated exact browser origins (scheme + host + optional port only).
# Same-origin deployments do not need this setting.
ALLOWED_ORIGINS=

# Enable only behind a trusted reverse proxy.
TRUST_PROXY=false
