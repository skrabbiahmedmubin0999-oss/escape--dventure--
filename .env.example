# Escape Adventure - Environment Configuration Example

# Server execution
PORT=3000
NODE_ENV=development

# Durable data directory. In production this must be backed by persistent storage.
DATA_DIR=.data

# Required in production: generate a unique random value of at least 32 characters.
# For example: openssl rand -hex 32
SESSION_SECRET=

# Optional exact frontend origins for cross-origin API access, comma-separated.
# Leave empty for same-origin-only API use.
ALLOWED_ORIGINS=

# Set true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
