# Escape Adventure - Environment Configuration Example

# Server execution settings
PORT=3000
NODE_ENV=development

# Optional browser origin allowed to call the API (exact origin, including scheme and port)
# CORS_ORIGIN=https://your-game.example.com

# Set a random secret of at least 32 characters in production. Never commit the real value.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
